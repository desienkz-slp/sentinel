# ============================================================================
#  NOC Sentinel — environment produksi (CT Proxmox).
#  Salin ke /opt/noc-sentinel/.env (install-ct.sh melakukannya otomatis) lalu
#  isi nilai REPLACE_*. Jangan commit file .env (gitignored).
#  Provider LLM TETAP EKSTERNAL: CT hanya memanggil endpoint lewat jaringan.
# ============================================================================

# ---- listen ----
NOC_ADDR=:8090

# ---- LLM provider (EKSTERNAL, bukan di CT) ----
NOC_LLM_BASE_URL=https://provider-anda.example/v1
NOC_LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
NOC_LLM_MODEL=ag/gemini-3.8-flash-high
NOC_LLM_WIRE_API=chat
NOC_LLM_TIMEOUT=120
NOC_MAX_STEPS=12

# ---- Codex CLI eskalasi (provider eksternal) ----
NOC_CODEX_PATH=codex
NOC_CODEX_MODEL=claude-sonnet-4.6
NOC_CODEX_SANDBOX=read-only
NOC_CODEX_BASE_URL=https://griphubrouter.web.id/v1
NOC_CODEX_PROVIDER=
NOC_CODEX_API_KEY=REPLACE_WITH_CODEX_KEY
NOC_CODEX_WIRE_API=messages

# ---- WhatsApp Gateway (di-spawn Go dari wa-gateway/) ----
NOC_WA_DIR=/opt/noc-sentinel/wa-gateway
NOC_WA_BASE_URL=http://127.0.0.1:3001
NOC_WA_TIMEOUT=45
NOC_WA_AUTO_REPLY=true
NOC_WA_ASYNC=false
NOC_WA_AUTOSTART=true
NOC_WA_GROUP=false
NOC_WA_BLOCKLIST=
NOC_NUMBER=
NOC_ADMIN_NUMBER=

# ---- Keamanan (WAJIB bila dashboard diakses dari luar loopback/LAN) ----
NOC_OPERATOR_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
NOC_WEBHOOK_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# Daftar target diagnostik yang diizinkan (pisahkan koma).
NOC_DIAG_ALLOWLIST=

# ---- PostgreSQL (CT infra / compose deploy/noc-infra.compose.yml) ----
NOC_POSTGRES_HOST=127.0.0.1
NOC_POSTGRES_PORT=5432
NOC_POSTGRES_USER=noc_app
NOC_POSTGRES_PASSWORD=REPLACE_WITH_LONG_UNIQUE_SECRET
NOC_POSTGRES_DB=noc_sentinel

# ---- Redis ----
NOC_REDIS_ADDR=127.0.0.1:6379
NOC_REDIS_PASSWORD=REPLACE_WITH_LONG_UNIQUE_SECRET

# ---- Adaptor eksternal (read-only; aktifkan via tools/registry.yaml) ----
NOC_BILLING_URL=https://member.netora.id
NOC_BILLING_TOKEN=REPLACE_WITH_64_HEX_KEY
NOC_RADIUS_URL=http://172.18.20.140
NOC_RADIUS_TOKEN=REPLACE_WITH_RADIUS_TOKEN
NOC_MIKROTIK_HOST=192.168.171.1
NOC_MIKROTIK_PORT=8118
NOC_MIKROTIK_USER=staff
NOC_MIKROTIK_PASS=REPLACE_WITH_ROUTER_PASSWORD
NOC_MIKROTIK_TLS=false
NOC_GENIEACS_URL=http://172.18.20.226:7557
